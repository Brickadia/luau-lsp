// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Extension",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/editors/code/scripts/build.ps1",
        "-Development",
        "-Server",
        "${workspaceFolder}/${input:binaryPath}/${input:binaryName}"
      ],
      "group": "build",
      "problemMatcher": [],
      "detail": "Bundle the extension with esbuild and copy in the server"
    },
    {
      "label": "Build Server",
      "type": "shell",
      "command": "${command:cmake.tasksBuildCommand}",
      "group": "build",
      "problemMatcher": [
        {
          "fileLocation": "absolute",
          "pattern": [
            {
              "regexp": "\"(.*)\", line (\\d+): (info|warning|(?:|fatal |catastrophic )error) \\((.*)\\): (.*)$",
              "file": 1,
              "line": 2,
              "severity": 3,
              "code": 4,
              "message": 5
            }
          ]
        }
      ],
      "options": {
        "shell": { "executable": "cmd.exe", "args": ["/d", "/c"] }
      },
      "detail": "Build Language Server Binary"
    },
    {
      "label": "Build Server and Extension",
      "dependsOn": ["Build Server", "Build Extension"],
      "dependsOrder": "sequence",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ],
  "inputs": [
    {
      "id": "binaryPath",
      "type": "pickString",
      "description": "Path to build folder containing 'luau-lsp'",
      "default": "cmake-build-relwithdebinfo-visual-studio",
      "options": [
        "cmake-build-debug-visual-studio",
        "cmake-build-release-visual-studio",
        "cmake-build-relwithdebinfo-visual-studio",
        "cmake-build-debug",
        "cmake-build-release",
        "cmake-build-relwithdebinfo"
      ]
    },
    {
      "id": "binaryName",
      "type": "pickString",
      "description": "Server executable name",
      "default": "luau-lsp.exe",
      "options": ["luau-lsp.exe", "luau-lsp"]
    }
  ]
}
